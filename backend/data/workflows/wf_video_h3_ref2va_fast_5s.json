{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "H3 扩散模型(本地)"
    },
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "H3 文本编码器(Qwen3-VL)"
    },
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "H3 视频 VAE"
    },
    "inputs": {
      "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "H3 音频 VAE"
    },
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "5": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": {
      "title": "H3 Sigma 偏移"
    },
    "inputs": {
      "model": [
        "35",
        0
      ],
      "shift_video": 12.0,
      "shift_audio": 3.0
    }
  },
  "7": {
    "class_type": "RandomNoise",
    "_meta": {
      "title": "$seed.noise_seed"
    },
    "inputs": {
      "noise_seed": 42
    }
  },
  "8": {
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "采样器"
    },
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "9": {
    "class_type": "BasicScheduler",
    "_meta": {
      "title": "调度(结构参数，不开放)"
    },
    "inputs": {
      "model": [
        "5",
        0
      ],
      "scheduler": "simple",
      "steps": 4,
      "denoise": 1.0
    }
  },
  "10": {
    "class_type": "BasicGuider",
    "_meta": {
      "title": "引导(H3 为 CFG 蒸馏，无负向)"
    },
    "inputs": {
      "model": [
        "5",
        0
      ],
      "conditioning": [
        "6",
        0
      ]
    }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "音视频联合采样"
    },
    "inputs": {
      "noise": [
        "7",
        0
      ],
      "guider": [
        "10",
        0
      ],
      "sampler": [
        "8",
        0
      ],
      "sigmas": [
        "9",
        0
      ],
      "latent_image": [
        "6",
        1
      ]
    }
  },
  "12": {
    "class_type": "LTXVSeparateAVLatent",
    "_meta": {
      "title": "拆分音视频 latent"
    },
    "inputs": {
      "av_latent": [
        "11",
        0
      ]
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "解码视频"
    },
    "inputs": {
      "samples": [
        "12",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "14": {
    "class_type": "VAEDecodeAudio",
    "_meta": {
      "title": "解码音频"
    },
    "inputs": {
      "samples": [
        "12",
        1
      ],
      "vae": [
        "4",
        0
      ]
    }
  },
  "15": {
    "class_type": "CreateVideo",
    "_meta": {
      "title": "合成(24fps)"
    },
    "inputs": {
      "images": [
        "13",
        0
      ],
      "fps": 24.0,
      "audio": [
        "14",
        0
      ]
    }
  },
  "16": {
    "class_type": "SaveVideo",
    "_meta": {
      "title": "$output.clip"
    },
    "inputs": {
      "video": [
        "15",
        0
      ],
      "filename_prefix": "video/h3_fast_5s",
      "format": "auto",
      "codec": "auto"
    }
  },
  "6": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "_meta": {
      "title": "H3 Ref2VA, $prompt.prompt!, $length, $width!, $height!"
    },
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "audio_vae": [
        "4",
        0
      ],

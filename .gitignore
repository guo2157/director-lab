# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
# TypeScript 增量构建缓存（每次构建都变，不入库）
*.tsbuildinfo

# 数据与媒体（不入库）
# 注意：必须是 data/* 而非 data/，否则 Git 不会进入目录、下方例外规则失效
backend/data/*
# 工作流定义是 seed_workflows.py 的数据源，且音色性别/描述标注只存在于 meta 中，必须入库
!backend/data/workflows/
backend/data/workflows/_removed/
*.db
*.db-wal
*.db-shm

# 环境
.env
.env.local

# 系统
.DS_Store
# 运行日志
uvicorn.log
*.log

# 备份文件（防止环境配置/代码备份误提交）
*.bak
*.bak.*
*.bak_*
.env.bak

# 归档压缩包（不入库，避免仓库膨胀）
*.tar.gz
*.tgz
*.zip

# 桌面打包产物
dist_desktop/
build/
backend/packaging/bin/

# 编辑器临时文件
*.orcaterm-tmp-file-change-*
.bak_*/
backend/.bak_*/

# 调试与临时输出（不入库）
backend/funcs.txt
backend/pytest_*.txt
backend/verify_session.txt
# 一次性排查脚本（保留 seed_workflows.py / verify_full_e2e_test.sh 等正式脚本）
backend/scripts/_debug_*.py
backend/scripts/_inspect_wf.py
backend/scripts/_kf_status.py
backend/scripts/_fix_*.py
backend/scripts/_repair_*.py
backend/scripts/_test_rewrite_refs.py

sales/xianyu/raw/*.png
